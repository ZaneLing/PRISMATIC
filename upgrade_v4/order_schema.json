{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRISMATIC research order bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orders"
  ],
  "properties": {
    "orders": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "drug_name",
          "ingredient_id",
          "formulation",
          "concentration",
          "atc4",
          "dose_unit",
          "route",
          "frequency",
          "duration",
          "indication",
          "fluid_purpose",
          "reassessment",
          "dose_value",
          "volume_ml",
          "rate_ml_h",
          "evidence_ids",
          "uncertainty"
        ],
        "additionalProperties": false,
        "properties": {
          "drug_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "ingredient_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "formulation": {
            "type": [
              "string",
              "null"
            ]
          },
          "concentration": {
            "type": [
              "string",
              "null"
            ]
          },
          "atc4": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][0-9]{2}[A-Z]{2}$"
          },
          "dose_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "frequency": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "indication": {
            "type": [
              "string",
              "null"
            ]
          },
          "fluid_purpose": {
            "enum": [
              "resuscitation",
              "maintenance",
              "replacement",
              "carrier",
              "flush",
              "unknown",
              null
            ]
          },
          "reassessment": {
            "type": [
              "string",
              "null"
            ]
          },
          "dose_value": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "volume_ml": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "rate_ml_h": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
